<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.FXML.PersonalViewController">
   <children>
      <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#abrirModal" prefHeight="34.0" prefWidth="110.0" styleClass="btnNuevo" stylesheets="@../assets/styles/nuevopersonalmod.css" text="Agregar Nuevo" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0" />
      <TableView fx:id="tablaPersonal" minWidth="700.0" stylesheets="@../assets/styles/personalview.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="55.0">
         <columns>
            <TableColumn fx:id="colID" prefWidth="36.0" text="ID" />
            <TableColumn fx:id="colCedula" prefWidth="82.0" text="CI" />
            <TableColumn fx:id="colNombre" prefWidth="116.0" text="Nombre" />
            <TableColumn fx:id="conPaterno" prefWidth="86.0" text="Apellido Paterno" />
            <TableColumn fx:id="colMaterno" text="Apellido Materno" />
            <TableColumn fx:id="colFecha" text="Fecha de Ingreso" />
            <TableColumn fx:id="colDireccion" text="Direccion" />
            <TableColumn fx:id="colTelefono" text="Telefono" />
            <TableColumn fx:id="colEstado" text="Estado" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <TextField fx:id="txtBuscarPersonal" layoutX="14.0" layoutY="23.0" onKeyReleased="#buscar" prefHeight="34.0" prefWidth="300.0" promptText="🔎 Buscar Por Nombre o CI" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
      <Button fx:id="btnEditar" layoutX="320.0" layoutY="23.0" mnemonicParsing="false" onAction="#editarPersonal" text="Editar" disable="true" AnchorPane.topAnchor="10.0" />
   </children>
</AnchorPane>
